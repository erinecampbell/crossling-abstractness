@article{jaruskova2023,
  title = {How to {{Build}} a {{Communicative Development Inventory}}: {{Insights From}} 43 {{Adaptations}}},
  shorttitle = {How to {{Build}} a {{Communicative Development Inventory}}},
  author = {Jar{\r u}{\v s}kov{\'a}, Lucie and Smol{\'i}k, Filip and Chl{\'a}dkov{\'a}, Kate{\v r}ina and Ocel{\'a}kov{\'a}, Zuzana and Paillereau, Nikola},
  year = 2023,
