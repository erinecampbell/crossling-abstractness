  file = {/Users/erinecampbell/Zotero/storage/HBHZBKSL/Thompson et al. - 2020 - A data-driven approach to the semantics of iconici.pdf;/Users/erinecampbell/Zotero/storage/GJAXQ9T9/B61B5D15A94E10ECDEC431798DD176AE.html}
