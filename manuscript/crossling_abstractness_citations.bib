  title = {Developmental Inventories Using Illiterate Parents as Informants: {{Communicative Development Inventory}} ({{CDI}}) Adaptation for Two {{Kenyan}} Languages},
  shorttitle = {Developmental Inventories Using Illiterate Parents as Informants},
  author = {Alcock, K. J. and Rimba, K. and Holding, P. and {Kitsao-Wekulo}, P. and Abubakar, A. and Newton, C. R. J. C.},
  year = 2015,
