  doi = {10.1111/mila.12473},
  urldate = {2025-11-25},
  abstract = {Many psychologists currently assume that there is a psychologically real distinction to be made between concepts that are abstract and concepts that are concrete. It is for example largely agreed that concepts and words are more easily processed if they are concrete. Moreover, it is assumed that this is because these words and concepts are concrete. It is thought that interesting generalizations can be made about certain concepts because they are concrete. I argue that we have surprisingly little reason to believe that the abstract-concrete distinction is psychologically real.},
